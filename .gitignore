# ===== Python 运行缓存（自动生成，无需上传）=====
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# ===== 工具数据目录（用户数据：扫描结果 data.json、配置 config.json、日志等）=====
# v1.2 起就在工具文件夹内（starchart\.starchart\），属于个人数据，不入库
# 注意：config.json 含 DPAPI 加密的 API Key，绝对不能入库
.starchart/

# ===== 运行时产物（旧版本兼容：早期日志/临时文件会生成在根目录）=====
server.log
server.log.1
*.tmp
*.corrupt-*
*.bak
# 根目录下划线开头的临时验证产物（UI 验证截图/脚本等一次性产物）
/_*.js
/_*.png

# ===== AI / 开发工具的本地工作目录（工具生成，非项目代码）=====
# 如需在仓库内共享 Claude/CodeBuddy 的项目配置，删除对应行即可
.agents/
.claude/
.codebuddy/
.workbuddy/
.impeccable/
.mimosa/

# ===== Python 虚拟环境与打包产物（本地环境，体积大且因人而异）=====
venv/
.venv/
env/
build/
dist/
*.egg-info/

# ===== Node（前端无构建步骤；防止误装依赖后误入库）=====
node_modules/

# ===== 环境变量 / 密钥（防止泄漏本地配置）=====
.env

# ===== 操作系统自动生成的垃圾文件 =====
# Windows
Thumbs.db
Desktop.ini
# macOS
.DS_Store

# ===== 编辑器 / IDE 配置（个人设置，无需共享）=====
.vscode/
.idea/
*.swp
